# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=FloodShield
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Replace with your actual PostgreSQL credentials
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/floodshield
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── External Services ─────────────────────────────────────────────────────────
RISK_ENGINE_URL=http://localhost:8001
ROUTE_ENGINE_URL=http://localhost:8002
WEATHER_API_KEY=your_weather_api_key_here
FLOOD_DATA_API_KEY=your_flood_api_key_here
